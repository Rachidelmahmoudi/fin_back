###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
#DATABASE_URL="mysql://root:root@127.0.0.1:3306/finpha?serverVersion=10.11&charset=utf8mb4"
#DATABASE_URL="postgresql://finpharma:finpharma@127.0.0.1:5432/finpharma?serverVersion=16&charset=utf8"
DATABASE_URL="postgresql://finpharma:finpharma@127.0.0.1:5433/finpharma?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=finpharma
###< lexik/jwt-authentication-bundle ###

###> FinPharma ###
# §10 SeoService : base pour canonical/hreflang/JSON-LD (Phase 4d)
APP_BASE_URL=https://finpharma.ma
# §18 CORS : domaines autorisés à appeler l'API (site web + app mobile Capacitor)
CORS_ALLOW_ORIGIN='^https?://((www\.)?finpharma\.ma|localhost(:[0-9]+)?|127\.0\.0\.1(:[0-9]+)?)$|^capacitor://localhost$|^ionic://localhost$'
###< FinPharma ###

###> FinPharma Ask IA (§25) ###
# ExternalAiProvider — AUCUN fournisseur IA choisi ni clé fournie dans ce
# projet : ces valeurs sont des placeholders. Sans AI_PROVIDER_API_KEY
# définie, le service répond 503 explicitement plutôt que d'échouer
# silencieusement (voir ExternalAiProvider::askAboutMedicine()).
AI_PROVIDER_API_URL=https://api.openai.com/v1/chat/completions
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4o-mini
###< FinPharma Ask IA ###

###> symfony/mailer ###
MAILER_DSN=smtp://localhost:1025
MAILER_FROM=no-reply@finpharma.ma
###< symfony/mailer ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###

###> Google Maps (optionnel) ###
# Laisser vide = carte OpenStreetMap. Clé restreinte par domaine (HTTP referrer).
GOOGLE_MAPS_API_KEY=
###< Google Maps ###
