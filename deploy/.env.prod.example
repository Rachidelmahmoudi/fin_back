# Copier en deploy/.env.prod puis remplir (ne JAMAIS committer)
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGER_openssl_rand_hex_32
DB_PASSWORD=CHANGER_mot_de_passe_fort
DATABASE_URL="postgresql://finpharma:CHANGER_mot_de_passe_fort@db:5432/finpharma?serverVersion=16&charset=utf8"
JWT_SECRET_KEY=/app/config/jwt/private.pem
JWT_PUBLIC_KEY=/app/config/jwt/public.pem
JWT_PASSPHRASE=CHANGER_passphrase
CORS_ALLOW_ORIGIN='^https://((www\.)?finpharma\.ma)$|^capacitor://localhost$|^https://localhost$|^ionic://localhost$'
MAILER_DSN=smtp://USER:PASS@smtp.exemple.com:587
MAILER_FROM=no-reply@finpharma.ma
MESSENGER_TRANSPORT_DSN=doctrine://default
GOOGLE_MAPS_API_KEY=
ACME_EMAIL=toi@finpharma.ma
DEFAULT_URI=https://finpharma.ma
