{% extends 'admin/base.html.twig' %}
{% block title %}Créditer un utilisateur{% endblock %}

{% block body %}
<h1 class="admin-page-title">Créditer un utilisateur directement</h1>
<p class="admin-page-subtitle">
    À utiliser après réception d'un reçu (email + capture d'écran de virement/versement) sur WhatsApp —
    plus besoin que l'utilisateur déclare sa recharge dans l'app au préalable.
</p>

<form method="post" action="{{ path('admin_wallet_credit_direct') }}" class="admin-form">
    <div class="admin-form__grid">
        <label class="admin-form__field admin-form__field--full">
            <span>Email de l'utilisateur *</span>
            <input type="email" name="email" required placeholder="utilisateur@exemple.com">
        </label>
        <label class="admin-form__field">
            <span>Montant à créditer (DH) *</span>
            <input type="number" step="0.01" min="0.01" name="amount" required>
        </label>
        <label class="admin-form__field">
            <span>Note (optionnel)</span>
            <input type="text" name="note" placeholder="Ex : virement du 29/09, réf. XXXX">
        </label>
    </div>

    <div class="admin-form__actions">
        <button type="submit" class="admin-btn admin-btn--approve">Créditer</button>
    </div>
</form>
{% endblock %}
