{% extends 'admin/base.html.twig' %}
{% block title %}Recharges wallet{% endblock %}

{% block body %}
<h1 class="admin-page-title">Recharges à valider ({{ requests|length }})</h1>
<p class="admin-page-subtitle">
    Rapprochez chaque ligne du reçu reçu sur WhatsApp avant de confirmer.
    Le montant confirmé peut différer du montant annoncé si le reçu montre autre chose.
</p>

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr><th>Utilisateur</th><th>Méthode</th><th>Montant annoncé</th><th>Référence</th><th>Déclarée le</th><th></th></tr>
        </thead>
        <tbody>
            {% for r in requests %}
                <tr>
                    <td>{{ r.user.email }}</td>
                    <td>{{ r.method.value == 'PAYPAL' ? 'PayPal' : 'Virement bancaire' }}</td>
                    <td>{{ r.announcedAmount }} MAD</td>
                    <td>{{ r.reference|default('—') }}</td>
                    <td>{{ r.createdAt|date('d/m/Y H:i') }}</td>
                    <td class="admin-table__actions">
                        <form method="post" action="{{ path('admin_wallet_recharge_confirm', {id: r.id}) }}" class="admin-reject-form">
                            <input type="number" step="0.01" name="confirmedAmount" placeholder="{{ r.announcedAmount }}">
                            <button type="submit" class="admin-btn admin-btn--approve">Confirmer</button>
                        </form>
                        <form method="post" action="{{ path('admin_wallet_recharge_reject', {id: r.id}) }}" onsubmit="return confirm('Rejeter cette demande de recharge ?');">
                            <button type="submit" class="admin-btn admin-btn--reject">Rejeter</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="admin-empty-state">Aucune recharge en attente.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
