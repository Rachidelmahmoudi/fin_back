{# templates/components/card_laboratory.html.twig — Attend: laboratory (entité) #}
<article class="entity-card" data-pharmacy-card="{{ laboratory.id }}">
    <div class="entity-card__thumb entity-card__thumb--lab">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 3h6M10 3v5l-5 9a2 2 0 001.7 3h10.6a2 2 0 001.7-3l-5-9V3"/></svg>
        {% if laboratory.isVerified %}<span class="badge badge--verified">{{ 'establishment.verified'|trans }}</span>{% endif %}
    </div>
    <div class="entity-card__body">
        <h3><a href="{{ path('v1_laboratory_show', {_locale: app.request.locale, slug: laboratory.slug ~ '-' ~ laboratory.uid}) }}">{{ laboratory.name }}</a></h3>
        <p class="entity-card__address">{{ laboratory.addressRaw }}, {{ laboratory.city.name }}</p>
        {% if laboratory.labTests|length > 0 %}
            <p class="entity-card__tests">{{ laboratory.labTests|length }} {{ 'laboratory.tests_available'|trans }}</p>
        {% endif %}
        <div class="entity-card__meta">
            {% if laboratory.phone %}<a href="tel:{{ laboratory.phone }}" class="entity-card__phone">{{ laboratory.phone }}</a>{% endif %}
        </div>
    </div>
</article>
