{# templates/components/card_medicine.html.twig — Attend: medicine (entité) #}
<article class="medicine-card">
    <div class="medicine-card__thumb" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="8" width="18" height="8" rx="4"/><path d="M12 8v8"/></svg>
    </div>
    <div class="medicine-card__body">
        <h3><a href="{{ path('v1_medicine_show', {_locale: app.request.locale, slug: medicine.slug ~ '-' ~ medicine.uid}) }}">{{ medicine.name }}</a></h3>
        <p class="medicine-card__meta">{{ medicine.status|default('—') }} {{ medicine.presentation ? '| ' ~ medicine.presentation : '' }}</p>
        {% if medicine.ppvCnss %}<span class="badge badge--open">{{ 'medicine.cnss_reimbursed'|trans }}</span>{% endif %}
    </div>
    {% set price = medicine.ppvCnss ?? medicine.priceCommercial %}
    {% if price %}<div class="medicine-card__price">{{ price }} DH</div>{% endif %}
</article>
