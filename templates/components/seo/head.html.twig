{# templates/components/seo/head.html.twig
   §10 : consommé UNE fois par base.html.twig, jamais dupliqué par page.
   Attend une variable Twig `seo` (instance de App\Service\Seo\SeoMeta). #}

<title>{{ seo.title }}</title>
<meta name="description" content="{{ seo.description }}">
<link rel="canonical" href="{{ seo.canonical }}">

{% if seo.noindex %}
    <meta name="robots" content="noindex, nofollow">
{% endif %}

{% for locale, url in seo.hreflang %}
    <link rel="alternate" hreflang="{{ locale }}" href="{{ url }}">
{% endfor %}
<link rel="alternate" hreflang="x-default" href="{{ seo.hreflang.fr|default(seo.canonical) }}">

{# Open Graph #}
<meta property="og:title" content="{{ seo.title }}">
<meta property="og:description" content="{{ seo.description }}">
<meta property="og:url" content="{{ seo.canonical }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="FinPharma">
{% for image in seo.ogImages %}
    <meta property="og:image" content="{{ image }}">
{% endfor %}

{# Twitter/X Card #}
<meta name="twitter:card" content="{{ seo.ogImages|length > 0 ? 'summary_large_image' : 'summary' }}">
<meta name="twitter:title" content="{{ seo.title }}">
<meta name="twitter:description" content="{{ seo.description }}">

{% for block in seo.jsonLd %}
    <script type="application/ld+json">{{ block|json_encode|raw }}</script>
{% endfor %}
