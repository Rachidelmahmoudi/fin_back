{% extends 'base.html.twig' %}

{% block body %}
<section class="hero">
    <div class="hero__inner">
        <h1>{{ 'home.hero_title'|trans }}</h1>
        <p class="hero__subtitle">{{ 'home.hero_subtitle'|trans }}</p>

        {# Patron findoctor : onglets de type au-dessus de la recherche —
           adapté aux 3 types d'établissement FinPharma plutôt qu'à
           All/Doctor/Clinic. Chaque onglet change juste l'action du
           formulaire (JS minimal), pas 3 formulaires dupliqués. #}
        <div class="hero__search-card">
            <div class="hero__tabs" role="tablist">
                <button type="button" class="hero__tab is-active" data-target="pharmacy">{{ 'nav.pharmacies'|trans }}</button>
                <button type="button" class="hero__tab" data-target="doctor">{{ 'nav.doctors'|trans }}</button>
                <button type="button" class="hero__tab" data-target="laboratory">{{ 'nav.laboratories'|trans }}</button>
            </div>
            <form class="hero__search" id="hero-search-form" action="{{ path('v1_pharmacy_list', {_locale: app.request.locale, city: null}) }}" method="get">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <input id="hero-search-q" type="text" name="q" placeholder="{{ 'home.search_placeholder'|trans }}">
                <button type="submit" class="btn btn--primary">{{ 'home.search_cta'|trans }}</button>
            </form>
        </div>
    </div>
</section>

{# Patron findoctor "Discover the online appointment" — adapté : 3 étapes
   qui expliquent la proposition de valeur FinPharma, pas de RDV en ligne
   (non demandé au cahier des charges), mais la même logique de
   réassurance en 3 points. #}
<section class="how-it-works">
    <div class="how-it-works__inner">
        <h2>{{ 'home.how_title'|trans }}</h2>
        <p class="how-it-works__subtitle">{{ 'home.how_subtitle'|trans }}</p>

        <div class="how-it-works__steps">
            <div class="how-it-works__step">
                <span class="how-it-works__icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></span>
                <h3>{{ 'home.how_step1_title'|trans }}</h3>
                <p>{{ 'home.how_step1_desc'|trans }}</p>
            </div>
            <div class="how-it-works__step">
                <span class="how-it-works__icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7v10l10 5 10-5V7L12 2z"/></svg></span>
                <h3>{{ 'home.how_step2_title'|trans }}</h3>
                <p>{{ 'home.how_step2_desc'|trans }}</p>
            </div>
            <div class="how-it-works__step">
                <span class="how-it-works__icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.7a2 2 0 01-.4 2.1L8.1 9.6a16 16 0 006.3 6.3l1.1-1.2a2 2 0 012.1-.4c.9.3 1.8.5 2.7.6a2 2 0 011.7 2.1z"/></svg></span>
                <h3>{{ 'home.how_step3_title'|trans }}</h3>
                <p>{{ 'home.how_step3_desc'|trans }}</p>
            </div>
        </div>
    </div>
</section>

<section class="services">
    <div class="services__inner">
        <a href="{{ path('v1_pharmacy_list', {_locale: app.request.locale, city: null}) }}" class="service-card">
            <span class="service-card__icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7v10l10 5 10-5V7L12 2z" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.5"/></svg>
            </span>
            <h2>{{ 'home.service_pharmacies'|trans }}</h2>
            <p>{{ 'home.service_pharmacies_desc'|trans }}</p>
        </a>

        <a href="{{ path('v1_pharmacy_duty_list', {_locale: app.request.locale, city: null}) }}" class="service-card service-card--accent">
            <span class="service-card__icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 2v20M2 12h20" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/></svg>
            </span>
            <h2>{{ 'home.service_duty'|trans }}</h2>
            <p>{{ 'home.service_duty_desc'|trans }}</p>
        </a>

        <a href="{{ path('v1_laboratory_list', {_locale: app.request.locale, city: null}) }}" class="service-card">
            <span class="service-card__icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M9 3h6M10 3v5l-5 9a2 2 0 001.7 3h10.6a2 2 0 001.7-3l-5-9V3" stroke="currentColor" stroke-width="1.5"/></svg>
            </span>
            <h2>{{ 'home.service_labs'|trans }}</h2>
            <p>{{ 'home.service_labs_desc'|trans }}</p>
        </a>

        <a href="{{ path('v1_medicine_list', {_locale: app.request.locale}) }}" class="service-card">
            <span class="service-card__icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><rect x="3" y="8" width="18" height="8" rx="4" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v8" stroke="currentColor" stroke-width="1.5"/></svg>
            </span>
            <h2>{{ 'home.service_medicines'|trans }}</h2>
            <p>{{ 'home.service_medicines_desc'|trans }}</p>
        </a>
    </div>
</section>

{# Patron findoctor "Find your doctor or clinic" (Search by City / Search
   by type) — le bloc le plus directement utile ici : c'est littéralement
   la stratégie de SEO local du §11 du cahier des charges rendue visible et
   cliquable pour l'utilisateur, pas juste une astuce SEO cachée. #}
<section class="browse">
    <div class="browse__inner">
        <h2>{{ 'home.browse_title'|trans }}</h2>
        <p class="browse__subtitle">{{ 'home.browse_subtitle'|trans }}</p>

        <div class="browse__columns">
            <div class="browse__col">
                <h3>{{ 'home.browse_by_city'|trans }}</h3>
                <ul class="browse__list">
                    {% for row in citiesWithCount %}
                        <li>
                            <a href="{{ path('v1_pharmacy_list', {_locale: app.request.locale, city: row.city.slug}) }}">
                                <span class="browse__count">{{ row.count }}</span>
                                {{ row.city.name }}
                            </a>
                        </li>
                    {% else %}
                        <li class="browse__empty">{{ 'home.browse_no_data'|trans }}</li>
                    {% endfor %}
                </ul>
                {% if citiesWithCount|length > 0 %}
                    <a href="{{ path('v1_pharmacy_list', {_locale: app.request.locale, city: null}) }}" class="browse__more">{{ 'home.browse_more'|trans }}</a>
                {% endif %}
            </div>

            <div class="browse__col">
                <h3>{{ 'home.browse_by_specialty'|trans }}</h3>
                <ul class="browse__list">
                    {% for specialty in specialties %}
                        <li>
                            <a href="{{ path('v1_doctor_list_by_specialty', {_locale: app.request.locale, specialty: specialty.slug}) }}">
                                {{ specialty.name }}
                            </a>
                        </li>
                    {% else %}
                        <li class="browse__empty">{{ 'home.browse_no_data'|trans }}</li>
                    {% endfor %}
                </ul>
                {% if specialties|length > 0 %}
                    <a href="{{ path('v1_doctor_list', {_locale: app.request.locale}) }}" class="browse__more">{{ 'home.browse_more'|trans }}</a>
                {% endif %}
            </div>
        </div>
    </div>
</section>

{# Patron findoctor "Download App Now" — pertinent ici car FinPharma a
   réellement une app mobile Ionic à part du site (§19-26 du cahier des
   charges), contrairement au template d'origine où ça vend le même
   produit sous deux formes. #}
<section class="app-cta">
    <div class="app-cta__inner">
        <div class="app-cta__illustration" aria-hidden="true">
            <img src="{{ asset('images/logo-icon.png') }}" alt="" width="120" height="120">
        </div>
        <div class="app-cta__text">
            <p class="app-cta__eyebrow">{{ 'home.app_eyebrow'|trans }}</p>
            <h2>{{ 'home.app_title'|trans }}</h2>
            <p>{{ 'home.app_desc'|trans }}</p>
            <div class="app-cta__badges">
                <a href="#" aria-label="App Store">{{ 'home.app_store'|trans }}</a>
                <a href="#" aria-label="Google Play">{{ 'home.google_play'|trans }}</a>
            </div>
        </div>
    </div>
</section>

<section class="cta-establishment">
    <div class="cta-establishment__inner">
        <div>
            <h2>{{ 'home.cta_establishment_title'|trans }}</h2>
            <p>{{ 'home.cta_establishment_desc'|trans }}</p>
        </div>
        <a href="{{ path('v1_establishment_choose', {_locale: app.request.locale}) }}" class="btn btn--secondary">{{ 'nav.add_establishment'|trans }}</a>
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script>
// Onglets de recherche hero (patron findoctor) : change juste l'action et
// le placeholder du formulaire selon le type sélectionné — un seul
// formulaire, pas 3 dupliqués.
(function () {
    var targets = {
        pharmacy: { action: "{{ path('v1_pharmacy_list', {_locale: app.request.locale, city: null}) }}", placeholder: "{{ 'home.search_placeholder'|trans }}" },
        doctor: { action: "{{ path('v1_doctor_list', {_locale: app.request.locale}) }}", placeholder: "{{ 'home.search_placeholder_doctor'|trans }}" },
        laboratory: { action: "{{ path('v1_laboratory_list', {_locale: app.request.locale, city: null}) }}", placeholder: "{{ 'home.search_placeholder_lab'|trans }}" },
    };
    var form = document.getElementById('hero-search-form');
    var input = document.getElementById('hero-search-q');
    document.querySelectorAll('.hero__tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
            document.querySelectorAll('.hero__tab').forEach(function (t) { t.classList.remove('is-active'); });
            tab.classList.add('is-active');
            var target = targets[tab.getAttribute('data-target')];
            form.action = target.action;
            input.placeholder = target.placeholder;
        });
    });
})();
</script>
{% endblock %}
