{% extends 'base.html.twig' %}

{% block body %}
<div class="static-page">
    {% include 'components/breadcrumbs.html.twig' with {items: [
        {name: 'nav.home'|trans, url: path('v1_home', {_locale: app.request.locale})},
        {name: 'footer.services'|trans, url: path('v1_service_index', {_locale: app.request.locale})},
        {name: 'footer.find_medicine'|trans, url: null},
    ]} %}

    <header class="static-page__header">
        <h1>{{ 'footer.find_medicine'|trans }}</h1>
        <p>{{ 'service.find_medicine_intro'|trans }}</p>
    </header>

    <form class="static-page__form">
        <label>
            <span>{{ 'service.medicine_name'|trans }}</span>
            <input type="text" name="medicine" placeholder="{{ 'medicine.search_placeholder'|trans }}">
        </label>
        <label>
            <span>{{ 'service.your_city'|trans }}</span>
            <input type="text" name="city">
        </label>
        <label class="static-page__upload">
            <span>{{ 'service.upload_prescription'|trans }}</span>
            <input type="file" name="prescription" accept="image/*">
        </label>
        <button type="submit" class="btn btn--primary">{{ 'service.submit_search'|trans }}</button>
    </form>
</div>
{% endblock %}
