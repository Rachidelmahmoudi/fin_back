{% extends 'base.html.twig' %}

{% block body %}
<div class="pharmacy-page">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            {name: 'nav.home'|trans, url: path('v1_home', {_locale: app.request.locale})},
            {name: 'nav.doctors'|trans, url: path('v1_doctor_list', {_locale: app.request.locale})},
            {name: doctor.name, url: null},
        ]
    } %}

    <div class="detail-page__header">
        <div class="detail-page__photo detail-page__photo--avatar">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-7 8-7s8 3 8 7"/></svg>
        </div>
        <div class="detail-page__title">
            {% if doctor.specialties|length > 0 %}<p class="entity-card__eyebrow">{{ doctor.specialties|map(s => s.name)|join(', ') }}</p>{% endif %}
            <h1>{{ doctor.name }}</h1>
            <p class="detail-page__address">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-7.5 8-13a8 8 0 10-16 0c0 5.5 8 13 8 13z"/><circle cx="12" cy="9" r="3"/></svg>
                {{ doctor.addressRaw }}, {{ doctor.city.name }}
            </p>
            {% if doctor.isVerified %}<span class="badge badge--verified">{{ 'establishment.verified'|trans }}</span>{% endif %}
        </div>
        <div class="detail-page__share">
            <button type="button" class="icon-btn" aria-label="{{ 'detail.favorite'|trans }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.6l-1-1a5.5 5.5 0 00-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 000-7.8z"/></svg></button>
            <button type="button" class="icon-btn" aria-label="{{ 'detail.share'|trans }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg></button>
        </div>
    </div>

    <div class="detail-page__layout">
        <div class="detail-page__main">
            {% if doctor.bio %}
            <section class="detail-page__section"><h2>{{ 'doctor.about'|trans }}</h2><p>{{ doctor.bio }}</p></section>
            {% endif %}

            <section class="detail-page__section">
                <h2>{{ 'detail.location'|trans }}</h2>
                <div class="pharmacy-page__map" id="doctor-map" data-map="detail" data-lat="{{ doctor.lat }}" data-lng="{{ doctor.lng }}" data-empty-label="{{ 'pharmacy.map_no_data'|trans }}"></div>
            </section>

            {% if nearby|length > 0 %}
            <section class="detail-page__section">
                <h2>{{ 'detail.nearby_doctors'|trans({'%city%': doctor.city.name}) }}</h2>
                <div class="detail-page__nearby">
                    {% for n in nearby %}{% include 'components/card_doctor.html.twig' with {doctor: n} %}{% endfor %}
                </div>
            </section>
            {% endif %}
        </div>

        <aside class="contact-card">
            {% if doctor.phone %}<a href="tel:{{ doctor.phone }}" class="btn btn--primary contact-card__cta">{{ 'pharmacy.call'|trans }} — {{ doctor.phone }}</a>{% endif %}
            {% if doctor.lat and doctor.lng %}<a href="https://www.google.com/maps/dir/?api=1&destination={{ doctor.lat }},{{ doctor.lng }}" target="_blank" rel="noopener" class="btn btn--outline contact-card__cta">{{ 'pharmacy.directions'|trans }}</a>{% endif %}
            <ul class="contact-card__facts">
                {% if doctor.consultationPrice %}<li><span>{{ 'doctor.consultation_price'|trans }}</span><span>{{ doctor.consultationPrice }} DH</span></li>{% endif %}
                {% if doctor.email %}<li><span>{{ 'establishment.email'|trans }}</span><a href="mailto:{{ doctor.email }}">{{ doctor.email }}</a></li>{% endif %}
                <li><span>{{ 'detail.city'|trans }}</span><span>{{ doctor.city.name }}</span></li>
            </ul>
        </aside>
    </div>
</div>
{% endblock %}

{% block javascripts %}<script defer src="{{ asset('js/map.js') }}"></script>{% endblock %}
