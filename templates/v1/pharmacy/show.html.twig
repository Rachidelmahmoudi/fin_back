{% extends 'base.html.twig' %}

{% block body %}
<div class="pharmacy-page">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            {name: 'nav.home'|trans, url: path('v1_home', {_locale: app.request.locale})},
            {name: 'nav.pharmacies'|trans, url: path('v1_pharmacy_list', {_locale: app.request.locale, city: null})},
            {name: pharmacy.name, url: null},
        ]
    } %}

    <div class="detail-page__header">
        <div class="detail-page__photo">
            {% if pharmacy.photo %}
                <img src="{{ pharmacy.photo }}" alt="{{ pharmacy.name }}">
            {% endif %}
            {% if pharmacy.onDutyNow %}<span class="badge badge--duty">{{ 'pharmacy.on_duty'|trans }}</span>
            {% elseif pharmacy.openNow %}<span class="badge badge--open">{{ 'pharmacy.open_now'|trans }}</span>{% endif %}
        </div>
        <div class="detail-page__title">
            <h1>{{ pharmacy.name }}</h1>
            <p class="detail-page__address">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-7.5 8-13a8 8 0 10-16 0c0 5.5 8 13 8 13z"/><circle cx="12" cy="9" r="3"/></svg>
                {{ pharmacy.addressRaw }}, {{ pharmacy.city.name }}
            </p>
            {% if pharmacy.isVerified %}<span class="badge badge--verified">{{ 'establishment.verified'|trans }}</span>{% endif %}
        </div>
        <div class="detail-page__share">
            <button type="button" class="icon-btn" title="{{ 'detail.favorite'|trans }}" aria-label="{{ 'detail.favorite'|trans }}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.6l-1-1a5.5 5.5 0 00-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 000-7.8z"/></svg>
            </button>
            <button type="button" class="icon-btn" title="{{ 'detail.share'|trans }}" aria-label="{{ 'detail.share'|trans }}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
            </button>
        </div>
    </div>

    <div class="detail-page__layout">
        <div class="detail-page__main">
            {% if pharmacy.openingHours|length > 0 %}
            <section class="detail-page__section">
                <h2>{{ 'pharmacy.hours'|trans }}</h2>
                <ul class="fact-list">
                    {% for hour in pharmacy.openingHours|sort((a, b) => a.dayOfWeek <=> b.dayOfWeek) %}
                        <li><span>{{ ('days.' ~ hour.dayOfWeek)|trans }}</span><span>{{ hour.opensAt|date('H:i') }} - {{ hour.closesAt|date('H:i') }}</span></li>
                    {% endfor %}
                </ul>
            </section>
            {% endif %}

            <section class="detail-page__section">
                <h2>{{ 'detail.location'|trans }}</h2>
                <div class="pharmacy-page__map" id="pharmacy-detail-map" data-map="detail" data-lat="{{ pharmacy.lat }}" data-lng="{{ pharmacy.lng }}" data-empty-label="{{ 'pharmacy.map_no_data'|trans }}"></div>
            </section>

            {% if nearby|length > 0 %}
            <section class="detail-page__section">
                <h2>{{ 'detail.nearby'|trans({'%city%': pharmacy.city.name}) }}</h2>
                <div class="detail-page__nearby">
                    {% for n in nearby %}
                        {% include 'components/card_pharmacy.html.twig' with {pharmacy: n, distance: null} %}
                    {% endfor %}
                </div>
            </section>
            {% endif %}
        </div>

        {# Card de contact flottante — patron directory classique (ansonika
           findoctor : sidebar sticky à côté du contenu plutôt qu'un simple
           bloc d'actions en haut de page) : regroupe tout ce qui permet
           d'agir (appeler, itinéraire) sans avoir à remonter en haut. #}
        <aside class="contact-card">
            {% if pharmacy.phone %}
                <a href="tel:{{ pharmacy.phone }}" class="btn btn--primary contact-card__cta">{{ 'pharmacy.call'|trans }} — {{ pharmacy.phone }}</a>
            {% endif %}
            {% if pharmacy.lat and pharmacy.lng %}
                <a href="https://www.google.com/maps/dir/?api=1&destination={{ pharmacy.lat }},{{ pharmacy.lng }}" target="_blank" rel="noopener" class="btn btn--outline contact-card__cta">{{ 'pharmacy.directions'|trans }}</a>
            {% endif %}
            <ul class="contact-card__facts">
                {% if pharmacy.email %}<li><span>{{ 'establishment.email'|trans }}</span><a href="mailto:{{ pharmacy.email }}">{{ pharmacy.email }}</a></li>{% endif %}
                {% if pharmacy.website %}<li><span>{{ 'detail.website'|trans }}</span><a href="{{ pharmacy.website }}" target="_blank" rel="noopener">{{ pharmacy.website }}</a></li>{% endif %}
                <li><span>{{ 'detail.city'|trans }}</span><span>{{ pharmacy.city.name }}</span></li>
            </ul>
        </aside>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script defer src="{{ asset('js/map.js') }}"></script>
{% endblock %}
